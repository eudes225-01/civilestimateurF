# Copier ce fichier en .env.local et renseigner les valeurs nécessaires.
# Toutes les variables sont facultatives : sans VITE_API_URL, l'application
# fonctionne entièrement en local (métré, DQE, export PDF calculés dans le
# navigateur via civilestimateur-engine) — seule la lecture automatique de
# plan nécessite le backend.

# Vidéo tutoriel « créer un fichier IFC », affichée avant les dépôts de plans (paysage 16:9,
# démarrage automatique à la première visite, facultative). Lien YouTube, Vimeo ou .mp4.
# Laisser vide : la vidéo n'est pas affichée. Peut aussi se régler dans src/config/video.js.
VITE_VIDEO_IFC_URL=

# URL du backend (civilestimateur-backend). Laisser vide pour le mode 100% local.
VITE_API_URL=

# Site portfolio d'ArchiNova : le mot « ArchiNova » du pied de page y mène.
# Laisser vide : le nom s'affiche sans lien.
VITE_PORTFOLIO_URL=

# EmailJS — notification admin à l'ouverture d'une session (facultatif).
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=service_ljozok4
VITE_EMAILJS_ADMIN=archinova87@gmail.com
VITE_EMAILJS_TPL_ADMIN_NEW=

# Comptes et projets enregistrés — Supabase (connexion Google). Voir docs/AUTH-GOOGLE.md.
# Laisser vide : l'application fonctionne sans compte (développement local).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Adresse de contact affichée dans les conditions d'utilisation (paiements, données). Facultatif.
VITE_CONTACT_EMAIL=archinova87@gmail.com
